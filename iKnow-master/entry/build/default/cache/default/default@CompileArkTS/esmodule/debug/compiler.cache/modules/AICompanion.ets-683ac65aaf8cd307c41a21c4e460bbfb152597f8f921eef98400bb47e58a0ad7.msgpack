/** AI è€ƒä¼´ â€”â€” é•¿æœŸå…³ç³»å»ºç«‹é¡µ */
@Entry
@Component
export struct AICompanion {
  @State messages: AIMessage[] = []
  @State inputValue: string = ''
  @State answering: boolean = false
  private quickPrompts: string[] = ['å¸®æˆ‘è§„åˆ’ä»Šå¤©çš„å­¦ä¹ ', 'æˆ‘ä»Šå¤©çŠ¶æ€ä¸å¥½', 'ä¸ºä»€ä¹ˆæˆ‘æœ€è¿‘æ€»æ˜¯å®¹æ˜“åˆ†å¿ƒï¼Ÿ', 'å¸®æˆ‘è°ƒæ•´ä¸‹å‘¨å­¦ä¹ è®¡åˆ’']

  aboutToAppear(): void {
    this.pushAI(AIService.getInstance().companionIntro())
  }

  private pushAI(content: string): void {
    const m = new AIMessage()
    m.id = IdUtils.uuid()
    m.role = MessageRole.AI
    m.content = content
    m.timestamp = Date.now()
    this.messages.push(m)
  }

  private async send(text?: string): Promise<void> {
    const content = text !== undefined ? text : this.inputValue.trim()
    if (content.length === 0 || this.answering) {
      return
    }
    this.inputValue = ''
    const um = new AIMessage()
    um.id = IdUtils.uuid()
    um.role = MessageRole.USER
    um.content = content
    um.timestamp = Date.now()
    this.messages.push(um)

    this.answering = true
    const reply = await AIService.getInstance().chat(content)
    this.answering = false
    this.pushAI(reply)
  }

  @Builder
  bubble(m: AIMessage) {
    if (m.role === MessageRole.AI) {
      Row() {
        Text('ğŸ’¡').fontSize(16)
        Text(m.content)
          .fontSize(15)
          .fontColor(Colors.TEXT_PRIMARY)
          .backgroundColor(Colors.CARD)
          .padding(12)
          .borderRadius(16)
          .constraintSize({ maxWidth: '78%' })
          .margin({ left: 8 })
      }
      .width('100%')
      .justifyContent(FlexAlign.Start)
    } else {
      Row() {
        Text(m.content)
          .fontSize(15)
          .fontColor(Colors.TEXT_PRIMARY)
          .backgroundColor(Colors.PRIMARY_SOFT)
          .padding(12)
          .borderRadius(16)
          .constraintSize({ maxWidth: '78%' })
      }
      .width('100%')
      .justifyContent(FlexAlign.End)
    }
  }

  build() {
    Column() {
      Row() {
        Text('AI è€ƒä¼´')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor(Colors.TEXT_PRIMARY)
        Blank()
        AITag()
      }
      .width('100%')
      .padding({ left: 20, right: 20, top: 16, bottom: 10 })

      Scroll() {
        Column({ space: Spacing.MD }) {
          ForEach(this.messages, (m: AIMessage) => {
            this.bubble(m)
          }, (m: AIMessage) => m.id)

          if (this.answering) {
            Text('å°ä¼´æ€è€ƒä¸­â€¦')
              .fontSize(13)
              .fontColor(Colors.TEXT_TERTIARY)
              .margin({ left: 24 })
          }

          // å¿«æ·æé—®
          Column() {
            Text('å¯ä»¥è¯•è¯•é—®æˆ‘').fontSize(12).fontColor(Colors.TEXT_TERTIARY).width('100%')
            ForEach(this.quickPrompts, (p: string) => {
              Text(p)
                .fontSize(13)
                .fontColor(Colors.PRIMARY_DARK)
                .padding({ left: 12, right: 12, top: 8, bottom: 8 })
                .backgroundColor(Colors.PRIMARY_SOFT)
                .borderRadius(16)
                .margin({ right: 8, top: 8 })
                .onClick(() => {
                  this.send(p)
                })
            }, (p: string) => p)
          }
          .width('100%')
          .alignItems(HorizontalAlign.Start)
          .margin({ top: 16 })
        }
        .padding(20)
        .width('100%')
      }
      .layoutWeight(1)
      .align(Alignment.Top)

      Row() {
        TextInput({ placeholder: 'å’Œå°ä¼´è¯´ç‚¹ä»€ä¹ˆâ€¦' })
          .fontSize(15)
          .height(44)
          .layoutWeight(1)
          .backgroundColor(Colors.CARD)
          .borderRadius(22)
          .onChange((v: string) => {
            this.inputValue = v
          })
          .onSubmit(() => {
            this.send()
          })

        Button('å‘é€')
          .height(44)
          .fontSize(15)
          .fontColor(Color.White)
          .backgroundColor(Colors.PRIMARY)
          .borderRadius(22)
          .margin({ left: 10 })
          .onClick(() => {
            this.send()
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 8, bottom: 16 })
    AIFirstDisclaimer()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(Colors.BG)
  }
}
