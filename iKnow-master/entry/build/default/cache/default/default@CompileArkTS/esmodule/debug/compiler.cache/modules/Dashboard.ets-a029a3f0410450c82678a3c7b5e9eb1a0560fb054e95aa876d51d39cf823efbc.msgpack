  @StorageProp(StorageKey.FOCUS_RATE) focusRate: number = 0
  @StorageProp(StorageKey.DATA_VERSION) @Watch('refresh') dataVersion: number = 0
  @State weekTrend: number[] = []
  @State subjects: SubjectProgress[] = []
  @State examType: string = 'è€ƒç ”'
  @State greeting: string = ''
  @State showAvatarSheet: boolean = false
  private weekLabels: string[] = ['ä¸€', 'äºŒ', 'ä¸‰', 'å››', 'äº”', 'å…­', 'æ—¥']

  aboutToAppear(): void {
    this.refresh()
  }

  /** é¡¶éƒ¨é—®å€™è¯­ï¼ˆæŒ‰å½“å‰æ—¶é—´ï¼‰+ ç™»å½•ç”¨æˆ·å */
  private displayName(): string {
    const n = this.nickname.length > 0 ? this.nickname : AppStore.getInstance().getUser().nickname
    return n.length > 0 ? n : 'åŒå­¦'
  }

  refresh(): void {
    this.greeting = TimeUtils.greeting(Date.now())
    const store = AppStore.getInstance()
    const d = store.getDashboard()
    this.weekTrend = d.weekTrend
    this.subjects = d.subjectProgress
    this.examType = store.getGoal().examType
  }

  @Builder
  sectionTitle(title: string) {
    Text(title)
      .fontSize(16)
      .fontWeight(FontWeight.Medium)
      .fontColor(Colors.TEXT_PRIMARY)
      .width('100%')
      .margin({ bottom: 12 })
  }

  build() {
    Stack({ alignContent: Alignment.TopStart }) {
      Scroll() {
        Column({ space: Spacing.LG }) {
        // é¡¶éƒ¨é—®å€™ï¼ˆæŒ‰å½“å‰æ—¶é—´ç”Ÿæˆ + ç™»å½•ç”¨æˆ·åï¼‰+ å³ä¸Šè§’å¤´åƒ
        Row() {
          Column() {
            Text(`${this.greeting}ï¼Œ${this.displayName()}`)
              .fontSize(24)
              .fontWeight(FontWeight.Bold)
              .fontColor(Colors.TEXT_PRIMARY)
              .width('100%')
            Text('ä»Šå¤©ä¹Ÿä¸€èµ·ç¨³ç¨³æ¨è¿›å§')
              .fontSize(13)
              .fontColor(Colors.TEXT_SECONDARY)
              .margin({ top: 6 })
              .width('100%')
          }
          .layoutWeight(1)
          .alignItems(HorizontalAlign.Start)

          // å³ä¸Šè§’å¤´åƒï¼šç‚¹å‡»å³å¯æ›´æ¢
          Column() {
            UserAvatar({ avatar: this.avatar, diameter: 52, bg: Colors.PRIMARY_SOFT })
          }
          .onClick(() => {
            this.showAvatarSheet = true
          })
        }
        .width('100%')
        .alignItems(VerticalAlign.Center)

        // è€ƒè¯•æ€»è§ˆ
        Column() {
          Row() {
            Column() {
              Text('è€ƒè¯•æ€»è§ˆ')
                .fontSize(14)
                .fontColor(Colors.TEXT_SECONDARY)
              Text(this.examType)
                .fontSize(22)
                .fontWeight(FontWeight.Bold)
                .fontColor(Colors.PRIMARY_DARK)
                .margin({ top: 6 })
            }
            .alignItems(HorizontalAlign.Start)
            .layoutWeight(1)
            Column() {
              Text(`${this.examDays}`)
                .fontSize(34)
                .fontWeight(FontWeight.Bold)
                .fontColor(Colors.TEXT_PRIMARY)
              Text('å¤©')
                .fontSize(12)
                .fontColor(Colors.TEXT_SECONDARY)
            }
            .alignItems(HorizontalAlign.Center)
          }
          .width('100%')
          Text(`è·ç¦» ${this.examType} è¿˜æœ‰ ${this.examDays} å¤©ï¼ŒæŒ‰èŠ‚å¥ç¨³æ­¥æ¨è¿›`)
            .fontSize(12)
            .fontColor(Colors.TEXT_TERTIARY)
            .margin({ top: 10 })
            .width('100%')
        }
        .dashCard()

        // æ€»ä½“è¿›åº¦
        Column() {
          this.sectionTitle('æ€»ä½“è¿›åº¦')
          Row() {
            Text(`${this.todayDone} / ${this.todayTotal}`)
              .fontSize(20)
              .fontWeight(FontWeight.Medium)
              .fontColor(Colors.TEXT_PRIMARY)
            Blank()
            Text(this.todayTotal > 0 ? `${Math.round(this.todayDone / this.todayTotal * 100)}%` : 'â€”')
              .fontSize(18)
              .fontWeight(FontWeight.Medium)
              .fontColor(Colors.PRIMARY_DARK)
          }
          .width('100%')
          .margin({ bottom: 10 })
          Progress({
            value: this.todayDone,
            total: Math.max(1, this.todayTotal),
            type: ProgressType.Linear
          })
            .color(Colors.PRIMARY)
            .backgroundColor(Colors.LINE)
            .width('100%')
          Text('ä»Šæ—¥ä»»åŠ¡å®Œæˆè¿›åº¦')
            .fontSize(12)
            .fontColor(Colors.TEXT_TERTIARY)
            .margin({ top: 8 })
            .width('100%')
        }
        .dashCard()

        // ç§‘ç›®è¿›åº¦
        Column() {
          this.sectionTitle('ç§‘ç›®è¿›åº¦')
          if (this.subjects.length === 0) {
            Text('å¼€å§‹å­¦ä¹ åï¼Œè¿™é‡Œä¼šæ˜¾ç¤ºå„å­¦ç§‘çš„å®Œæˆè¿›åº¦')
              .fontSize(13)
              .fontColor(Colors.TEXT_SECONDARY)
              .width('100%')
          } else {
            ForEach(this.subjects, (sp: SubjectProgress) => {
              Column() {
                Row() {
                  Text(sp.subject)
                    .fontSize(14)
                    .fontColor(Colors.TEXT_PRIMARY)
                  Blank()
                  Text(`${sp.percent}%`)
                    .fontSize(14)
                    .fontColor(Colors.PRIMARY_DARK)
                }
                .width('100%')
                Progress({ value: sp.percent, total: 100, type: ProgressType.Linear })
                  .color(Colors.PRIMARY)
                  .backgroundColor(Colors.LINE)
                  .width('100%')
                  .margin({ top: 8 })
              }
              .width('100%')
              .margin({ top: 14 })
            }, (sp: SubjectProgress) => sp.subject)
          }
        }
        .dashCard()

        // é•¿æœŸè¶‹åŠ¿
        Column() {
          this.sectionTitle('é•¿æœŸè¶‹åŠ¿')
          Text('è¿‘ 7 å¤©å‡€ä¸“æ³¨æ—¶é•¿ï¼ˆåˆ†é’Ÿï¼‰')
            .fontSize(12)
            .fontColor(Colors.TEXT_TERTIARY)
            .width('100%')
            .margin({ bottom: 10 })
          BarChart({ values: this.weekTrend, labels: this.weekLabels })
            .width('100%')
          Text(`æœ¬å‘¨ç´¯è®¡å‡€ä¸“æ³¨ ${TimeUtils.formatHMin(this.weekFocus)}`)
            .fontSize(13)
            .fontColor(Colors.TEXT_SECONDARY)
            .margin({ top: 10 })
            .width('100%')
        }
        .dashCard()

        Blank().height(20)
        }
        .padding(20)
        .width('100%')
      }
      .backgroundColor(Colors.BG)
      .width('100%')
      .height('100%')

      // å¤´åƒé€‰æ‹©å™¨ï¼ˆå³ä¸Šè§’å¤´åƒç‚¹å‡»åå¼¹å‡ºï¼‰
      AvatarPicker({
        show: this.showAvatarSheet,
        onClose: () => {
          this.showAvatarSheet = false
        }
      })
    }
    .width('100%')
    .height('100%')
  }
}

@Extend(Column)
function dashCard() {
  .width('100%')
  .padding(18)
  .backgroundColor(Colors.CARD)
  .borderRadius(Radius.LG)
  .alignItems(HorizontalAlign.Start)
}
