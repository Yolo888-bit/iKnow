                  .fill(d.connected ? Colors.GREEN : Colors.TEXT_TERTIARY)
                Text(d.connected ? 'å·²è¿æ¥' : 'æœªè¿æ¥')
                  .fontSize(12)
                  .fontColor(d.connected ? Colors.GREEN : Colors.TEXT_SECONDARY)
                  .margin({ left: 6 })
              }
            }
            .width('100%')
            .padding(16)
            .backgroundColor(Colors.CARD)
            .borderRadius(Radius.MD)
          }, (d: DeviceInfo) => d.type)
        }
        .width('100%')

        // æ¨¡æ‹Ÿè®¾å¤‡æ¨¡å¼
        Column() {
          Text('æ¨¡æ‹Ÿè®¾å¤‡æ¨¡å¼')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .width('100%')

          Text('å½“å‰ä¸º MVP æ¼”ç¤ºï¼Œæ‘„åƒå¤´/æ‰‹è¡¨æ•°æ®ç”±æ¨¡æ‹ŸæœåŠ¡æä¾›ã€‚å¯æ‰‹åŠ¨è§¦å‘çŠ¶æ€ï¼ŒéªŒè¯ä¸“æ³¨é¡µçš„ç»¿/é»„/çº¢è”åŠ¨ã€‚')
            .fontSize(13)
            .fontColor(Colors.TEXT_SECONDARY)
            .lineHeight(20)
            .width('100%')
            .margin({ top: 8 })

          Row({ space: 10 }) {
            Button('æ¨¡æ‹Ÿè½»åº¦åˆ†å¿ƒ')
              .layoutWeight(1)
              .height(42)
              .fontSize(13)
              .fontColor(Colors.TEXT_PRIMARY)
              .backgroundColor(Colors.YELLOW_SOFT)
              .borderRadius(Radius.MD)
              .onClick(() => {
                DeviceService.getInstance().simulateDistraction(false)
                promptAction.showToast({ message: 'å·²æ¨¡æ‹Ÿè½»åº¦åˆ†å¿ƒ' })
              })
            Button('æ¨¡æ‹Ÿé‡åº¦èµ°ç¥')
              .layoutWeight(1)
              .height(42)
              .fontSize(13)
              .fontColor(Colors.TEXT_PRIMARY)
              .backgroundColor(Colors.RED_SOFT)
              .borderRadius(Radius.MD)
              .onClick(() => {
                DeviceService.getInstance().simulateDistraction(true)
                promptAction.showToast({ message: 'å·²æ¨¡æ‹Ÿé‡åº¦èµ°ç¥' })
              })
            Button('æ¢å¤ä¸“æ³¨')
              .layoutWeight(1)
              .height(42)
              .fontSize(13)
              .fontColor(Colors.TEXT_PRIMARY)
              .backgroundColor(Colors.GREEN_SOFT)
              .borderRadius(Radius.MD)
              .onClick(() => {
                DeviceService.getInstance().resumeFocus()
                promptAction.showToast({ message: 'å·²æ¢å¤ä¸“æ³¨' })
              })
          }
          .width('100%')
          .margin({ top: 16 })
