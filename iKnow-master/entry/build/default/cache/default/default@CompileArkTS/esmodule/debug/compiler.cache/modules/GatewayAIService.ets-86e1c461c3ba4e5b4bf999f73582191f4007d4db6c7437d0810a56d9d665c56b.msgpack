            }
            const rawResult = res.result;
            const text = typeof rawResult === 'string' ? rawResult : '';
            if (text.length === 0) {
                return '';
            }
            const parsed = JSON.parse(text);
            const choices = parsed.choices;
            if (choices === undefined || choices.length === 0) {
