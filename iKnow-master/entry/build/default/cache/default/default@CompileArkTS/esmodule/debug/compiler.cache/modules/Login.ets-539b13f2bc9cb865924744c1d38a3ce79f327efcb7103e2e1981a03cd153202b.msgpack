          .fontColor(Colors.PRIMARY)
        Text('ä¸“æ³¨æ„ŸçŸ¥æ™ºèƒ½è€ƒä¼´')
          .fontSize(14)
          .fontColor(Colors.TEXT_SECONDARY)
          .margin({ top: 8 })
      }
      .margin({ bottom: 36 })

      // ç™»å½•å¡ç‰‡
      Column() {
        Text('ç™»å½• / æ³¨å†Œ')
          .fontSize(18)
          .fontWeight(FontWeight.Medium)
          .fontColor(Colors.TEXT_PRIMARY)
          .width('100%')

        TextInput({ placeholder: 'ç”¨æˆ·å' })
          .fontSize(15)
          .height(48)
          .margin({ top: 18 })
          .backgroundColor(Colors.BG)
          .borderRadius(Radius.MD)
          .onChange((v: string) => {
            this.username = v
          })

        TextInput({ placeholder: 'å¯†ç ï¼ˆè‡³å°‘ 6 ä½ï¼‰' })
          .type(InputType.Password)
          .fontSize(15)
          .height(48)
          .margin({ top: 12 })
          .backgroundColor(Colors.BG)
          .borderRadius(Radius.MD)
          .onChange((v: string) => {
            this.password = v
          })

        if (this.errorMsg.length > 0) {
          Text(this.errorMsg)
            .fontSize(13)
            .fontColor(Colors.CAMERA_RED)
            .width('100%')
            .margin({ top: 10 })
        }

        Button(this.loading ? 'ç™»å½•ä¸­â€¦' : 'ç™»å½•')
          .width('100%')
          .height(50)
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(Colors.PRIMARY)
          .borderRadius(Radius.LG)
          .margin({ top: 20 })
          .enabled(!this.loading)
          .onClick(() => {
            this.doLogin()
          })

        Text('é¦–æ¬¡ä½¿ç”¨è¯¥ç”¨æˆ·åä¼šè‡ªåŠ¨åˆ›å»ºæœ¬åœ°è´¦å·')
          .fontSize(12)
          .fontColor(Colors.TEXT_TERTIARY)
          .width('100%')
          .textAlign(TextAlign.Center)
          .margin({ top: 14 })
      }
      .width('100%')
      .padding(24)
      .backgroundColor(Colors.CARD)
      .borderRadius(Radius.LG)

      Text('ç™»å½•åï¼Œåº”ç”¨å†…çš„ç§°å‘¼å°†ä½¿ç”¨ä½ çš„ç”¨æˆ·å')
        .fontSize(12)
        .fontColor(Colors.TEXT_TERTIARY)
        .margin({ top: 20 })
    }
    .width('100%')
    .height('100%')
    .padding(28)
    .justifyContent(FlexAlign.Center)
    .backgroundColor(Colors.BG)
  }
