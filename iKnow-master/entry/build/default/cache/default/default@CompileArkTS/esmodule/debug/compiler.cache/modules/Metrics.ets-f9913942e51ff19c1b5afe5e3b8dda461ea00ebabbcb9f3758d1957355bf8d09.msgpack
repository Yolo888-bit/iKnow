Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚ8import { FocusState } from '../models/Enums';
import { TimeUtils } from '../utils/TimeUtils';
export class Metrics {
    // ===================== Â§5 åŸºç¡€å£å¾„ =====================
    /** Â§5 å¢™é’Ÿ = ä¼šè¯ running æœŸé—´å…¨éƒ¨æµé€æ—¶é—´ï¼ˆç§’ï¼‰ */
    static wallClock(s) {
        return s.totalDuration;
    }
    /** Â§5 ä¼‘æ¯ = ä¼‘æ¯æ—¶é•¿ï¼ˆç§’ï¼‰ */
    static restSec(s) {
        return s.breakDuration;
    }
    /** Â§5 æš‚åœ = æš‚åœæ—¶é•¿ï¼ˆç§’ï¼‰ */
    static pauseSec(s) {
        return s.pausedDuration;
