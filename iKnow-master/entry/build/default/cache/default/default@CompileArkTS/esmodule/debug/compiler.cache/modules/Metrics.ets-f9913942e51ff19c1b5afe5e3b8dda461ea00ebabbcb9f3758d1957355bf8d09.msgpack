    /** Â§5 åˆ†å¿ƒ = YELLOW + RED ç´¯è®¡ï¼ˆç§’ï¼‰ */
    static distractionSec(s) {
        return s.distractionDuration;
    }
    /** Â§5 ç­”ç–‘ = QAï¼ˆè®¡å…¥æ€»ï¼Œä¸è®¡å‡€ï¼‰ï¼ˆç§’ï¼‰ */
    static qaSec(s) {
        return s.qaDuration;
    }
    /** Â§5 å‡€ä¸“æ³¨ç‡ = å‡€ä¸“æ³¨ / æ€»å­¦ä¹ ï¼ˆ0-1ï¼‰ */
    static netFocusRate(s) {
        const t = Metrics.totalStudySec(s);
        return t > 0 ? s.focusDuration / t : 0;
    }
    /** Â§5 å‡€ä¸“æ³¨ç‡ï¼ˆç™¾åˆ†æ¯”æ•´æ•°ï¼‰ */
    static focusRatePercent(s) {
        return Math.round(Metrics.netFocusRate(s) * 100);
    }
    /** Â§5 åˆ†å¿ƒç‡ = åˆ†å¿ƒ / æ€»å­¦ä¹ ï¼ˆ0-1ï¼‰ */
    static distractionRate(s) {
        const t = Metrics.totalStudySec(s);
        return t > 0 ? s.distractionDuration / t : 0;
    }
    /**
     * Â§5 å®Œæˆç‡ï¼šä¼˜å…ˆæŒ‰ estimatedDuration åŠ æƒï¼Œæ— æƒé‡ä¿¡æ¯æ—¶æŒ‰ä»»åŠ¡æ•°ã€‚
     * @param estMap ä»»åŠ¡ id â†’ é¢„è®¡æ—¶é•¿ï¼ˆåˆ†é’Ÿï¼‰ï¼Œå¯é€‰ï¼›ç¼ºå¤±æ—¶é€€åŒ–ä¸ºä»»åŠ¡æ•°å£å¾„
     */
    static completionRate(s, estMap) {
        if (s.taskIds.length === 0) {
            return 100;
        }
        const done = s.completedTaskIds;
        if (estMap !== undefined && estMap.size > 0) {
            let total = 0;
            let comp = 0;
            for (const id of s.taskIds) {
                const e = estMap.get(id);
                total += e ?? 0;
                if (done.indexOf(id) >= 0) {
                    comp += e ?? 0;
                }
            }
            return total > 0 ? Math.round((comp / total) * 100) : 0;
        }
        return Math.round((done.length / s.taskIds.length) * 100);
    }
    // ===================== Â§5 è·¨ä¼šè¯æŒ‡æ ‡ =====================
    /**
     * Â§5 é»„é‡‘æ—¶æ®µï¼šæœ€è¿‘ 14 å¤©ï¼ŒæŒ‰ 2 å°æ—¶æ»‘åŠ¨çª—å£ç»Ÿè®¡æ€»å­¦ä¹ æ—¶é•¿ï¼Œè¿”å›å³°å€¼çª—å£çš„æ—¶é’ŸåŒºé—´ã€‚
     * æ— æ•°æ®è¿”å›ç©ºä¸²ã€‚
     */
    static goldenWindow(sessions) {
        const now = Date.now();
        const dayMs = 24 * 3600 * 1000;
        const buckets = new Array(12).fill(0); // 12 ä¸ª 2h çª—å£
        let found = false;
        for (const s of sessions) {
            if (now - s.startTime > 14 * dayMs || s.startTime > now) {
                continue;
            }
            const d = new Date(s.startTime);
            const idx = Math.floor((d.getHours() * 60 + d.getMinutes()) / 120);
            if (idx >= 0 && idx < 12) {
                buckets[idx] += Metrics.totalStudySec(s);
                found = true;
            }
        }
        if (!found) {
            return '';
        }
        let peak = 0;
        for (let i = 0; i < 12; i++) {
            if (buckets[i] > buckets[peak]) {
                peak = i;
            }
        }
        if (buckets[peak] <= 0) {
            return '';
        }
        const startMin = peak * 120;
        const endMin = startMin + 120;
        return `${Metrics.clock(startMin)} - ${Metrics.clock(endMin)}`;
    }
    /**
     * Â§5 æ˜“åˆ†å¿ƒä»»åŠ¡ï¼šè¿‘ä¼¼ä¸º"åˆ†å¿ƒç‡æœ€é«˜çš„ä¼šè¯"ï¼ˆMVP å ä½ï¼‰ã€‚
     * åç»­æ¥å…¥ä»»åŠ¡çº§åˆ†å¿ƒæ¬¡æ•°å½’å› åï¼Œæ”¹ä¸º åˆ†å¿ƒæ¬¡æ•° / ä»»åŠ¡æ—¶é•¿(åˆ†é’Ÿ)ã€‚
     */
    static easyDistractionTask(sessions) {
        let best = null;
        let bestRate = -1;
        for (const s of sessions) {
            const r = Metrics.distractionRate(s);
            if (r > bestRate) {
                bestRate = r;
                best = s;
            }
        }
        if (best === null) {
            return { subject: '', rate: 0 };
        }
        return { subject: best.title, rate: bestRate };
    }
    /**
     * Â§5 ä¸“æ³¨é˜ˆå€¼ï¼šæœ€è¿‘ N(>=3) æ¬¡ä¼šè¯ä¸­ï¼Œæ¯æ¬¡"æœ€é•¿è¿ç»­ GREEN æ®µï¼ˆåˆ†é’Ÿï¼‰"çš„ä¸­ä½æ•°ã€‚
     * æ ·æœ¬ä¸è¶³è¿”å› 0ã€‚
     */
    static focusThreshold(sessions) {
        const runs = [];
        for (const s of sessions) {
            let best = 0;
            let cur = 0;
            for (const p of s.timeline) {
                if (p.state === FocusState.FOCUSED) {
                    cur += 1;
                }
                else {
                    best = Math.max(best, cur);
                    cur = 0;
                }
            }
            best = Math.max(best, cur);
            runs.push(best * 0.5); // é‡‡æ ·ç²’åº¦çº¦ 30s â†’ æŠ˜ç®—åˆ†é’Ÿ
        }
        const last = runs.slice(-Metrics.MIN_SAMPLES);
        if (last.length < Metrics.MIN_SAMPLES) {
            return 0;
        }
        return Math.round(Metrics.median(last));
    }
    // ===================== Â§6 äº”ç»´ç”»åƒ =====================
    /**
     * Â§6 äº”ç»´ï¼ˆçº¯è®¡ç®—ï¼Œä¸å«æ ·æœ¬é—¨ç¦ï¼‰ã€‚
     * è°ƒç”¨æ–¹é¡»å…ˆç”¨ canShowProfile(sampleCount) åˆ¤æ–­æ˜¯å¦è¾¾åˆ° N>=3ï¼Œæœªè¾¾è¯·å‹¿æ¸²æŸ“æ•°å€¼ã€‚
     *  - efficiency     = 0.6*å‡€ä¸“æ³¨ç‡å‡å€¼ + 0.4*å®Œæˆç‡å‡å€¼
     *  - concentration  = å‡€ä¸“æ³¨ç‡å‡å€¼
     *  - stability      = å‡€ä¸“æ³¨ç‡åºåˆ— Ïƒï¼šÏƒ>0.3 â†’ 0ï¼›å¦åˆ™ 100*(1-Ïƒ/0.4)
     *  - execution      = å®Œæˆç‡å‡å€¼
     *  - antiDistraction= 100*(1-åˆ†å¿ƒç‡å‡å€¼)
     */
    static fiveDim(sessions) {
        const finished = sessions.filter((s) => Metrics.totalStudySec(s) > 0);
        if (finished.length === 0) {
            return { efficiency: 0, concentration: 0, stability: 0, execution: 0, antiDistraction: 0 };
        }
        const rates = finished.map((s) => Metrics.netFocusRate(s) * 100);
        const comps = finished.map((s) => Metrics.completionRate(s));
        const distrs = finished.map((s) => Metrics.distractionRate(s));
        const avgRate = Metrics.mean(rates);
        const avgComp = Metrics.mean(comps);
        const avgDistr = Metrics.mean(distrs);
        const sigma = Metrics.stddev(rates) / 100;
        const efficiency = Math.round(0.6 * avgRate + 0.4 * avgComp);
        const concentration = Math.round(avgRate);
        const stability = sigma > 0.3 ? 0 : Math.round(100 * (1 - Metrics.clamp(sigma / 0.4, 0, 1)));
        const execution = Math.round(avgComp);
        const antiDistraction = Math.round(100 * (1 - Metrics.clamp(avgDistr, 0, 1)));
        return { efficiency, concentration, stability, execution, antiDistraction };
    }
    /** Â§6 æ˜¯å¦è¾¾åˆ°å±•ç¤ºé—¨æ§›ï¼ˆN>=3ï¼‰ */
    static canShowProfile(sampleCount) {
        return sampleCount >= Metrics.MIN_SAMPLES;
    }
    // ===================== é•¿æœŸå¤ç›˜èšåˆï¼ˆÂ§5 æ´¾ç”Ÿï¼Œç»Ÿä¸€èµ° Metricsï¼‰=====================
    /** æœ€è¿‘ 30 å¤©å­¦ä¹ è¡¨ç°æ±‡æ€»ï¼šæ€»å­¦ä¹ å°æ—¶ã€å®Œæˆä»»åŠ¡æ•°ã€å¹³å‡ä¸“æ³¨ç‡ã€æ¯æ—¥å‡€ä¸“æ³¨åˆ†é’Ÿè¶‹åŠ¿ */
    static last30DaysSummary(sessions, tasks, now) {
        const dayMs = 24 * 3600 * 1000;
        const cutoff = now - 30 * dayMs;
        let totalNetSec = 0;
        let totalStudySec = 0;
        const completedIds = [];
        const trend = [];
        for (let i = 29; i >= 0; i--) {
            const dayStart = TimeUtils.dayStart(now) - i * dayMs;
            const dayEnd = dayStart + dayMs;
            let net = 0;
            for (const s of sessions) {
                if (s.startTime >= dayStart && s.startTime < dayEnd) {
                    net += s.focusDuration;
                }
            }
            trend.push(Math.round(net / 60));
        }
        for (const s of sessions) {
            if (s.startTime >= cutoff) {
                totalNetSec += s.focusDuration;
                totalStudySec += Metrics.totalStudySec(s);
                for (const id of s.completedTaskIds) {
                    if (completedIds.indexOf(id) < 0) {
                        completedIds.push(id);
                    }
                }
            }
        }
        const focusRate = totalStudySec > 0 ? Math.round(totalNetSec / totalStudySec * 100) : 0;
        return { totalHours: Math.round(totalNetSec / 3600), completedTasks: completedIds.length, focusRate: focusRate, trend: trend };
    }
    /** ç»ƒä¹ å†…å®¹æ€»ç»“ï¼šæŒ‰å­¦ç§‘ç»Ÿè®¡å·²å®Œæˆä»»åŠ¡æ¬¡æ•°ï¼Œè¿”å›å‰ 5 é¡¹ */
    static practiceSummary(sessions, tasks) {
        const taskMap = new Map();
        for (const t of tasks) {
            taskMap.set(t.id, t);
        }
        const groups = new Map();
        for (const s of sessions) {
            for (const id of s.completedTaskIds) {
                const t = taskMap.get(id);
                if (t !== undefined) {
                    let g = groups.get(t.subject);
                    if (g === undefined) {
                        g = { subject: t.subject, content: t.title, count: 0 };
                        groups.set(t.subject, g);
                    }
                    g.count++;
                }
            }
        }
        const result = [];
        groups.forEach((value, key) => {
            result.push(value);
        });
        result.sort((a, b) => b.count - a.count);
        return result.slice(0, 5);
    }
    /** å­¦ä¹ ä¹ æƒ¯æ´å¯Ÿï¼šé»„é‡‘æ—¶æ®µã€ä½è°·æ—¶æ®µä¸å¯æ“ä½œå»ºè®® */
    static habitInsights(sessions) {
        const bestWindow = Metrics.goldenWindow(sessions);
        let bestRate = 0;
        if (bestWindow.length > 0) {
            let sum = 0;
            let count = 0;
            for (const s of sessions) {
                if (Metrics.totalStudySec(s) > 0) {
                    sum += Metrics.netFocusRate(s) * 100;
                    count++;
                }
            }
            bestRate = count > 0 ? Math.round(sum / count) : 0;
        }
        return {
            bestWindow: bestWindow.length > 0 ? bestWindow : '08:00 - 10:00',
            bestRate: bestRate,
            lowWindow: 'æ™šé—´ 21 ç‚¹å',
            lowNote: 'å®¹æ˜“åˆ†å¿ƒ',
            advice: 'éš¾é¢˜ä¼˜å…ˆå®‰æ’ä¸Šåˆæ”»å…‹ï¼Œæ™šé—´ä»¥å¤ä¹ å’Œè½»é‡æ•´ç†ä¸ºä¸»ã€‚'
        };
    }
    // ===================== å¤ç›˜è¾…åŠ©ï¼ˆÂ§5 æ´¾ç”Ÿï¼Œç»Ÿä¸€èµ° Metricsï¼‰=====================
    /** å•æ¬¡ä¼šè¯æœ€ä½³ä¸“æ³¨æ—¶æ®µï¼šæœ€é•¿"é«˜ä¸“æ³¨(>=70)è¿ç»­æ®µ"å¯¹åº”çš„æ—¶é’ŸåŒºé—´ */
    static bestFocusPeriod(s) {
        const tl = s.timeline;
        if (tl.length === 0) {
            return '';
        }
        let bestStart = 0;
        let bestLen = 0;
        let curStart = 0;
        let curLen = 0;
        for (let i = 0; i < tl.length; i++) {
            const p = tl[i];
            if (p.level >= 70) {
                if (curLen === 0) {
                    curStart = p.minute;
                }
                curLen++;
                if (curLen > bestLen) {
                    bestLen = curLen;
                    bestStart = curStart;
                }
            }
            else {
                curLen = 0;
            }
        }
        if (bestLen === 0) {
            return '';
        }
        const startClock = Metrics.clock(bestStart);
        const endClock = Metrics.clock(bestStart + bestLen);
        return `${startClock} - ${endClock}`;
    }
    /** ç–²åŠ³ç‚¹ï¼šé¦–æ¬¡å‡ºç°åˆ†å¿ƒ/ä½ä¸“æ³¨ç­‰çº§çš„åˆ†é’Ÿ */
    static fatigueMinute(s) {
        for (const p of s.timeline) {
            if (p.state === FocusState.DISTRACTED || p.level < 45) {
                return p.minute;
            }
        }
        return 0;
    }
    /** åˆ†å¿ƒè§¦å‘æºï¼ˆå»é‡ï¼Œæœ€å¤š 3 æ¡ï¼‰ */
    static distractionTriggers(s) {
        const seen = [];
        for (const e of s.events) {
            if (e.state === FocusState.SLIGHTLY_DISTRACTED || e.state === FocusState.DISTRACTED) {
                const label = e.source === 'CAMERA' ? 'è§†çº¿ç¦»å¼€å±å¹•' : 'çŠ¶æ€æ³¢åŠ¨';
                if (seen.indexOf(label) < 0 && seen.length < 3) {
                    seen.push(label);
                }
            }
        }
        if (seen.length === 0 && s.distractionDuration > 0) {
            seen.push('è§†çº¿ç¦»å¼€å±å¹•');
        }
        return seen;
    }
    // ===================== å†…éƒ¨å·¥å…· =====================
    static clamp(v, lo, hi) {
        return Math.max(lo, Math.min(hi, v));
    }
    static mean(arr) {
        if (arr.length === 0) {
            return 0;
        }
        let sum = 0;
        for (const v of arr) {
            sum += v;
        }
        return sum / arr.length;
    }
    static stddev(arr) {
        if (arr.length === 0) {
            return 0;
        }
        const m = Metrics.mean(arr);
        let acc = 0;
        for (const v of arr) {
            acc += (v - m) * (v - m);
        }
        return Math.sqrt(acc / arr.length);
    }
    static median(arr) {
        if (arr.length === 0) {
            return 0;
        }
        const a = arr.slice().sort((x, y) => x - y);
        const mid = Math.floor(a.length / 2);
        return a.length % 2 === 0 ? (a[mid - 1] + a[mid]) / 2 : a[mid];
    }
    static clock(totalMin) {
        const h = Math.floor(totalMin / 60) % 24;
        const m = totalMin % 60;
        return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}`;
    }
    /** ç”±ä»»åŠ¡åˆ—è¡¨æ„å»º id â†’ é¢„è®¡æ—¶é•¿(åˆ†é’Ÿ) æ˜ å°„ï¼Œä¾› completionRate åŠ æƒä½¿ç”¨ */
    static buildEstMap(tasks) {
        const m = new Map();
        for (const t of tasks) {
            m.set(t.id, t.estimatedDuration);
        }
        return m;
    }
}
/** Â§6 / Â§5 ç»Ÿè®¡æœ€å°æ ·æœ¬æ•° N>=3ï¼ˆå°‘äºæ­¤æ•°ç”»åƒé¡µæ˜¾ç¤º"è¿˜åœ¨äº†è§£ä½ "ï¼Œç¦æ­¢æ˜¾ç¤ºé›·è¾¾æ•°å€¼ï¼‰ */
Metrics.MIN_SAMPLES = 3;
