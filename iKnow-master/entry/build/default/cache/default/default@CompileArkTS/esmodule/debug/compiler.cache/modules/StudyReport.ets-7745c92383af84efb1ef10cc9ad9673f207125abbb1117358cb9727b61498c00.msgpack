            this.sectionTitle('ä¸“æ³¨æ›²çº¿')
            FocusChart({ levels: this.levels, states: this.states })
          }
          .reportCard()

          // â‘¢ AI å­¦ä¹ æ´å¯Ÿ
          Column() {
            Row() {
              this.sectionTitle('AI å­¦ä¹ æ´å¯Ÿ')
              Blank()
              AITag()
            }
            Text(this.insights)
              .fontSize(15)
              .fontColor(Colors.TEXT_PRIMARY)
              .lineHeight(24)
              .margin({ top: 8 })
          }
          .reportCard()

          // â‘£ ä¼˜åŒ–å»ºè®®
          Column() {
            this.sectionTitle('ğŸ’¡ ä¸‹ä¸€æ¬¡å¯ä»¥è¿™æ ·è¯•è¯•')
            ForEach(this.suggestions, (s: string) => {
              Row() {
                Text('â€¢')
                  .fontSize(15)
                  .fontColor(Colors.PRIMARY_DARK)
                Text(s)
                  .fontSize(14)
                  .fontColor(Colors.TEXT_PRIMARY)
                  .margin({ left: 8 })
              }
              .width('100%')
              .margin({ top: 8 })
            }, (s: string) => s)
          }
          .reportCard()

          // â‘¤ ä»Šæ—¥é—®é¢˜è®°å½•
          if (this.questions.length > 0) {
            Column() {
              this.sectionTitle(`ä»Šå¤©ä½ é—®äº† ${this.qaCount} ä¸ªé—®é¢˜`)
              ForEach(this.questions, (q: QuestionRecord) => {
                Column() {
                  Text(q.question)
                    .fontSize(14)
                    .fontColor(Colors.TEXT_PRIMARY)
                  Text('â†’ æŸ¥çœ‹ç­”æ¡ˆ')
                    .fontSize(12)
                    .fontColor(Colors.PRIMARY_DARK)
                    .margin({ top: 6 })
                }
                .width('100%')
                .alignItems(HorizontalAlign.Start)
                .padding(12)
                .backgroundColor(Colors.BG)
                .borderRadius(Radius.MD)
                .margin({ top: 8 })
              }, (q: QuestionRecord) => q.id)
            }
            .reportCard()
          }

          Button('å®Œæˆ')
            .width('100%')
            .height(50)
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Color.White)
            .backgroundColor(Colors.PRIMARY)
            .borderRadius(Radius.LG)
            .margin({ top: 8 })
            .onClick(() => {
              this.finish()
            })

          Blank().height(24)
        }
      }
      .padding(20)
      .width('100%')
    }
    .backgroundColor(Colors.BG)
    .width('100%')
    .height('100%')
  }

  @Builder
  sectionTitle(title: string) {
    Text(title)
      .fontSize(16)
      .fontWeight(FontWeight.Medium)
      .fontColor(Colors.TEXT_PRIMARY)
      .width('100%')
  }

  @Builder
  stat(label: string, value: string) {
    Column() {
      Text(label)
        .fontSize(12)
        .fontColor(Colors.TEXT_SECONDARY)
      Text(value)
        .fontSize(20)
        .fontWeight(FontWeight.Medium)
        .fontColor(Colors.TEXT_PRIMARY)
        .margin({ top: 6 })
    }
    .layoutWeight(1)
    .padding(14)
    .backgroundColor(Colors.BG)
    .borderRadius(Radius.MD)
    .alignItems(HorizontalAlign.Start)
  }
}

@Extend(Column)
function reportCard() {
  .width('100%')
  .padding(18)
  .backgroundColor(Colors.CARD)
  .borderRadius(Radius.LG)
  .alignItems(HorizontalAlign.Start)
}
