     *  - èŠæ»¡ 4 è½®ä»æœªç»™è®¡åˆ’ â†’ å…œåº•èµ° task_plan ç›´æ¥æ‹†ä»»åŠ¡ã€‚
     */
    async send() {
        const text = this.inputValue.trim();
        if (text.length === 0 || this.thinking) {
            return;
        }
        this.inputValue = '';
        this.pushUser(text);
        this.userTexts.push(text);
        this.turns += 1;
        this.thinking = true;
        const input = { step: this.turns, userInput: text, history: this.history };
        const r = await AIService.getInstance().dialogByScene(input);
        this.thinking = false;
        const reply = r.reply.length > 0 ? r.reply : AIService.getInstance().planningHold();
        this.pushAI(reply);
        this.history.push(text);
        this.history.push(reply);
        // æ¨¡å‹åˆ¤æ–­ä¿¡æ¯è¶³å¤Ÿï¼šreply é‡Œå·²å«æ—¶é—´å®‰æ’å»ºè®®ï¼Œç›´æ¥è½åˆ°å¾…ç¡®è®¤åˆ—è¡¨
        const got = r.tasks;
        if (r.done && got !== undefined && got.length > 0) {
            this.applyPlan(got);
            return;
        }
        // å…œåº•ï¼šèŠæ»¡ 4 è½®è¿˜æ²¡å‡ºè®¡åˆ’ï¼Œå°±æŒ‰å·²æ”¶é›†çš„ä¿¡æ¯ç›´æ¥ç”Ÿæˆ
        if (this.turns >= 4) {
            await this.generatePlan();
        }
    }
    /** æŠŠ AI ç»™å‡ºçš„ç»“æ„åŒ–ä»»åŠ¡è½åˆ°ã€Œå¾…ç¡®è®¤ä»»åŠ¡ã€åˆ—è¡¨ */
    applyPlan(list) {
        const out = [];
        for (const p of list) {
            out.push(this.toTask(p));
        }
        if (out.length === 0) {
            return;
        }
        this.tasks = out;
        this.confirmedIds = [];
        this.showComposer = false;
    }
    composeGoal() {
        return this.userTexts.join('ï¼›');
    }
    /** å…œåº•è·¯å¾„ï¼šç›´æ¥æŒ‰å·²æ”¶é›†çš„ç›®æ ‡ç”Ÿæˆç»“æ„åŒ–ä»»åŠ¡ï¼ˆtask_plan åœºæ™¯ï¼‰ */
    async generatePlan() {
        this.thinking = true;
        const input = { goal: this.composeGoal() };
        const result = await AIService.getInstance().planByScene(input);
        this.thinking = false;
        if (result.tasks.length === 0) {
            this.pushAI(AIService.getInstance().planningHold());
            return;
        }
        if (result.summary.length > 0) {
            this.pushAI(result.summary);
        }
        this.applyPlan(result.tasks);
    }
    toTask(p) {
        const t = new Task();
        t.id = p.id.length > 0 ? p.id : IdUtils.uuid();
        t.title = p.title;
        t.subject = p.subject;
        t.estimatedDuration = p.estimatedDuration;
        t.sortOrder = p.sortOrder;
        t.createdAt = Date.now();
        return t;
    }
    // ---------- å¾…ç¡®è®¤ä»»åŠ¡ï¼šç¡®è®¤ / ç¼–è¾‘ ----------
    isConfirmed(id) {
        return this.confirmedIds.indexOf(id) >= 0;
    }
    toggleConfirm(id) {
        const next = [];
        let found = false;
        for (const x of this.confirmedIds) {
            if (x === id) {
                found = true;
            }
            else {
                next.push(x);
            }
        }
        if (!found) {
            next.push(id);
        }
        this.confirmedIds = next;
    }
    startEdit(t) {
        this.editId = t.id;
        this.draftTitle = t.title;
        this.draftSubject = t.subject;
        this.draftMinutes = t.estimatedDuration;
    }
    saveEdit() {
        const title = this.draftTitle.trim();
        const subject = this.draftSubject.trim();
        const next = [];
        for (const t of this.tasks) {
            const c = t.copy();
            if (c.id === this.editId) {
                c.title = title.length > 0 ? title : c.title;
                c.subject = subject.length > 0 ? subject : c.subject;
                c.estimatedDuration = this.draftMinutes;
            }
            next.push(c);
        }
        this.tasks = next;
        this.editId = '';
    }
    deleteTask() {
        const next = [];
        for (const t of this.tasks) {
            if (t.id !== this.editId) {
                next.push(t);
            }
        }
        this.tasks = next;
        this.editId = '';
    }
    // ---------- åº•éƒ¨ï¼šé¢„è®¡æ—¶é•¿ / å¼€å§‹ä¸“æ³¨ ----------
    selectedTasks() {
        if (this.confirmedIds.length === 0) {
