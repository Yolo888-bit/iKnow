  build() {
    Stack() {
      Column() {
        this.header()

        // å¯¹è¯ + å¾…ç¡®è®¤ä»»åŠ¡
        Scroll(this.scroller) {
          Column({ space: 18 }) {
            ForEach(this.messages, (m: AIMessage) => {
              if (m.role === MessageRole.AI) {
                this.aiBubble(m.content)
              } else {
                this.userBubble(m.content)
              }
            }, (m: AIMessage) => m.id)

            if (this.thinking) {
              this.aiBubble('æ­£åœ¨æ€è€ƒâ€¦')
            }

            if (this.tasks.length > 0) {
              this.planSection()
            }
          }
          .width('100%')
          .padding({ left: 16, right: 16, top: 10, bottom: 18 })
        }
        .layoutWeight(1)
        .align(Alignment.Top)
        .scrollBar(BarState.Off)
        .edgeEffect(EdgeEffect.Spring)

        // åº•éƒ¨ï¼šå‡ºè®¡åˆ’åå›ºå®šã€Œå¼€å§‹ä¸“æ³¨ã€ï¼Œå¦åˆ™ä¸ºè¾“å…¥æ 
        if (this.tasks.length > 0 && !this.showComposer) {
          this.startBar()
        } else {
          this.inputBar()
        }
      }
      .width('100%')
      .height('100%')

      if (this.editId.length > 0) {
        this.editPanel()
      }

      AIFirstDisclaimer()
    }
    .width('100%')
    .height('100%')
    .backgroundColor(Colors.BG)
  }
