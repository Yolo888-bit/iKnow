            .fontColor(Colors.TEXT_PRIMARY)
          Text(`æœ¬æ¬¡ç­”ç–‘æ—¶é—´ ${TimeUtils.formatClock(this.qaElapsed)}`)
            .fontSize(12)
            .fontColor(Colors.TEXT_SECONDARY)
            .margin({ top: 4 })
        }
        .alignItems(HorizontalAlign.Start)
        .layoutWeight(1)

        AITag()
      }
      .width('100%')
      .padding({ left: 20, right: 20, top: 14, bottom: 10 })

      Scroll() {
