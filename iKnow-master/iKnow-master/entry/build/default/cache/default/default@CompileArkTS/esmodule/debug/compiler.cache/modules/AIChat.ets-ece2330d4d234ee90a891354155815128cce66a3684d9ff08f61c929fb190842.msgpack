          ForEach(this.messages, (m: AIMessage) => {
            this.bubble(m)
          }, (m: AIMessage) => m.id)

          if (this.answering) {
            Text('å°ä¼´æ€è€ƒä¸­â€¦')
              .fontSize(13)
              .fontColor(Colors.TEXT_TERTIARY)
              .margin({ left: 24 })
          }
        }
        .padding(20)
        .width('100%')
      }
      .layoutWeight(1)
      .align(Alignment.Top)

      Button('è¿”å›ä¸“æ³¨')
        .width('100%')
        .height(44)
        .fontSize(15)
        .fontColor(Colors.TEXT_PRIMARY)
        .backgroundColor(Colors.CARD)
        .borderRadius(Radius.MD)
        .margin({ left: 20, right: 20, bottom: 8 })
        .onClick(() => {
          this.backToFocus()
        })

      Row() {
        TextInput({ placeholder: 'è¾“å…¥ä½ çš„é—®é¢˜â€¦' })
          .fontSize(15)
          .height(44)
          .layoutWeight(1)
          .backgroundColor(Colors.CARD)
          .borderRadius(22)
          .onChange((v: string) => {
            this.inputValue = v
          })
          .onSubmit(() => {
            this.send()
          })

        Button('å‘é€')
