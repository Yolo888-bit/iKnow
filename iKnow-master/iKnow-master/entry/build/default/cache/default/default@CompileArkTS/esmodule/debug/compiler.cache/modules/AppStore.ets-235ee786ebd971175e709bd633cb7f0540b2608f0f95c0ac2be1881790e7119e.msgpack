    // ---------- ç”¨æˆ· & ç›®æ ‡ ----------
    async saveUserNickname(nickname) {
        this.user.nickname = nickname;
        await StorageService.getInstance().saveUser(this.user);
        AppStorage.setOrCreate(StorageKey.USER_NICKNAME, nickname);
    }
    async saveUserPersonality(p) {
        this.user.aiPersonality = p;
        AIService.getInstance().setPersonality(p);
        await StorageService.getInstance().saveUser(this.user);
        AppStorage.setOrCreate(StorageKey.USER_PERSONALITY, p);
