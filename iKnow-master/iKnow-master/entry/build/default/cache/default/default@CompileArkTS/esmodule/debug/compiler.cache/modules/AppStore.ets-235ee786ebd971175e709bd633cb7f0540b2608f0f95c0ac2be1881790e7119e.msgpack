        AppStorage.setOrCreate(StorageKey.TODAY_TOTAL_TASKS, 0);
        AppStorage.setOrCreate(StorageKey.FOCUS_RATE, 0);
        AppStorage.setOrCreate(StorageKey.WEEK_FOCUS_SEC, 0);
        AppStorage.setOrCreate(StorageKey.WEEK_TREND, '[]');
        AppStorage.setOrCreate(StorageKey.EXAM_DAYS, 0);
