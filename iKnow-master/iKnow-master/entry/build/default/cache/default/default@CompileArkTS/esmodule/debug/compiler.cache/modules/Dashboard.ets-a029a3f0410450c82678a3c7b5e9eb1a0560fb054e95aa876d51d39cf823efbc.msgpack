/** æˆ‘çš„å·¥ä½œå° â€”â€” å­¦ä¹ å…¨å±€çœ‹æ¿ */
@Component
export struct Dashboard {
  @StorageProp(StorageKey.EXAM_DAYS) examDays: number = 0
  @StorageProp(StorageKey.TODAY_DONE_TASKS) todayDone: number = 0
  @StorageProp(StorageKey.TODAY_TOTAL_TASKS) todayTotal: number = 0
  @StorageProp(StorageKey.WEEK_FOCUS_SEC) weekFocus: number = 0
  @StorageProp(StorageKey.DATA_VERSION) @Watch('refresh') dataVersion: number = 0
  @State weekTrend: number[] = []
  @State subjects: SubjectProgress[] = []
  @State examType: string = 'è€ƒç ”'
  private weekLabels: string[] = ['ä¸€', 'äºŒ', 'ä¸‰', 'å››', 'äº”', 'å…­', 'æ—¥']

  aboutToAppear(): void {
    this.refresh()
  }

  refresh(): void {
    const d = AppStore.getInstance().getDashboard()
    this.weekTrend = d.weekTrend
    this.subjects = d.subjectProgress
    this.examType = AppStore.getInstance().getGoal().examType
  }

  build() {
    Scroll() {
      Column({ space: Spacing.LG }) {
        // é¡¶éƒ¨
        Column() {
          Text('æˆ‘çš„å·¥ä½œå°')
            .fontSize(24)
            .fontWeight(FontWeight.Bold)
            .fontColor(Colors.TEXT_PRIMARY)
            .width('100%')
          Text(`è·ç¦»${this.examType}è¿˜æœ‰ ${this.examDays} å¤©`)
            .fontSize(15)
            .fontColor(Colors.TEXT_SECONDARY)
            .margin({ top: 6 })
            .width('100%')
        }
        .width('100%')

        // ä»Šæ—¥ç›®æ ‡
        Column() {
          Text('ä»Šæ—¥ä»»åŠ¡')
            .fontSize(14)
            .fontColor(Colors.TEXT_SECONDARY)
            .width('100%')
          Text(`${this.todayDone} / ${this.todayTotal} å·²å®Œæˆ`)
            .fontSize(22)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .margin({ top: 4 })
            .width('100%')
          Progress({
            value: this.todayDone,
            total: Math.max(1, this.todayTotal),
            type: ProgressType.Linear
          })
            .color(Colors.PRIMARY)
            .backgroundColor(Colors.LINE)
            .width('100%')
            .margin({ top: 14 })
        }
        .dashCard()

        // æœ¬å‘¨å­¦ä¹ æ•°æ®
        Column() {
          Text('æœ¬å‘¨å·²å­¦ä¹ ')
            .fontSize(14)
            .fontColor(Colors.TEXT_SECONDARY)
            .width('100%')
          Text(TimeUtils.formatHMin(this.weekFocus))
            .fontSize(26)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .margin({ top: 4 })
            .width('100%')
          Text('è¿‘ 7 å¤©å‡€ä¸“æ³¨è¶‹åŠ¿ï¼ˆåˆ†é’Ÿï¼‰')
            .fontSize(12)
            .fontColor(Colors.TEXT_TERTIARY)
            .margin({ top: 4 })
            .width('100%')
          BarChart({ values: this.weekTrend, labels: this.weekLabels })
            .margin({ top: 12 })
            .width('100%')
        }
        .dashCard()

        // å­¦ç§‘è¿›åº¦
        Column() {
          Text('å­¦ç§‘ / ä»»åŠ¡è¿›åº¦')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .width('100%')
            .margin({ bottom: 12 })

          if (this.subjects.length === 0) {
            Text('å¼€å§‹å­¦ä¹ åï¼Œè¿™é‡Œä¼šæ˜¾ç¤ºå„å­¦ç§‘çš„è¿›åº¦')
              .fontSize(13)
              .fontColor(Colors.TEXT_SECONDARY)
              .width('100%')
          } else {
            ForEach(this.subjects, (sp: SubjectProgress) => {
              Column() {
                Row() {
                  Text(sp.subject)
                    .fontSize(14)
                    .fontColor(Colors.TEXT_PRIMARY)
                  Blank()
                  Text(`${sp.percent}%`)
                    .fontSize(14)
                    .fontColor(Colors.PRIMARY_DARK)
                }
                .width('100%')
                Progress({ value: sp.percent, total: 100, type: ProgressType.Linear })
                  .color(Colors.PRIMARY)
                  .backgroundColor(Colors.LINE)
                  .width('100%')
                  .margin({ top: 8 })
              }
              .width('100%')
              .margin({ top: 14 })
            }, (sp: SubjectProgress) => sp.subject)
          }
        }
        .dashCard()

        Blank().height(20)
      }
      .padding(20)
      .width('100%')
    }
    .backgroundColor(Colors.BG)
    .width('100%')
    .height('100%')
  }
}

@Extend(Column)
function dashCard() {
  .width('100%')
  .padding(18)
  .backgroundColor(Colors.CARD)
  .borderRadius(Radius.LG)
  .alignItems(HorizontalAlign.Start)
}
