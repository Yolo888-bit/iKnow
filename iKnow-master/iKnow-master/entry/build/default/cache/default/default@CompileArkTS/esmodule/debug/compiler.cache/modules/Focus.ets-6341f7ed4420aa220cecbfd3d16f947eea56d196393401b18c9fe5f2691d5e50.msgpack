                  .backgroundColor(Colors.CARD)
                  .height(38)
                  .borderRadius(19)
                  .onClick(() => {
                    this.showEndConfirm = true
                  })
              }
              .margin({ top: 16 })
            }
            .width('86%')
            .padding(16)
            .backgroundColor(Colors.RED_SOFT)
            .borderRadius(Radius.LG)
          }

          // æš‚åœï¼šè½»é‡æ¢å¤
          if (this.focusState === 'PAUSED') {
            Column() {
              Text('å·²æš‚åœ')
                .fontSize(15)
                .fontColor(Colors.TEXT_PRIMARY)
