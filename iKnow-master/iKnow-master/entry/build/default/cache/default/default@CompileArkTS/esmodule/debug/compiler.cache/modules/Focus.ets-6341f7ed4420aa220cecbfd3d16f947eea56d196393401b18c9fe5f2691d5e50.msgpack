            .borderRadius(Radius.LG)
          }

          // æš‚åœï¼šè½»é‡æ¢å¤
          if (this.focusState === 'PAUSED') {
            Column() {
              Text('å·²æš‚åœ')
                .fontSize(15)
                .fontColor(Colors.TEXT_PRIMARY)
              Button('ç»§ç»­ä¸“æ³¨')
                .fontSize(14)
                .fontColor(Color.White)
                .backgroundColor(Colors.PRIMARY)
                .height(40)
                .borderRadius(20)
                .margin({ top: 12 })
                .onClick(() => {
                  FocusController.getInstance().resume()
                })
            }
            .width('86%')
            .padding(16)
            .backgroundColor(Colors.CARD)
            .borderRadius(Radius.LG)
            .margin({ top: 24 })
          }
        }
        .width('100%')
        .padding({ left: 24, right: 24 })
        .layoutWeight(1)

        // åº•éƒ¨æ§åˆ¶
        Row({ space: 12 }) {
          Button(this.focusState === 'PAUSED' ? 'ç»§ç»­' : 'æš‚åœ')
            .layoutWeight(1)
            .height(46)
            .fontSize(15)
            .fontColor(Colors.TEXT_PRIMARY)
            .backgroundColor(Colors.CARD)
            .borderRadius(Radius.MD)
            .onClick(() => {
              this.togglePause()
            })
          Button('ä¼‘æ¯')
            .layoutWeight(1)
            .height(46)
            .fontSize(15)
            .fontColor(Colors.TEXT_PRIMARY)
            .backgroundColor(Colors.CARD)
            .borderRadius(Radius.MD)
            .onClick(() => {
              this.rest()
            })
          Button('ç»“æŸ')
            .layoutWeight(1)
            .height(46)
            .fontSize(15)
            .fontColor(Color.White)
