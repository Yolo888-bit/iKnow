              Text('éœ€è¦ä¼‘æ¯ä¸€ä¸‹ï¼Œè¿˜æ˜¯ç»§ç»­å­¦ä¹ ï¼Ÿ')
                .fontSize(13)
                .fontColor(Colors.TEXT_SECONDARY)
                .margin({ top: 6 })

              Row({ space: 10 }) {
                Button('ç»§ç»­å­¦ä¹ ')
                  .fontSize(13)
                  .fontColor(Color.White)
                  .backgroundColor(Colors.PRIMARY)
                  .height(38)
                  .borderRadius(19)
                  .onClick(() => {
                    this.continueFromRed()
