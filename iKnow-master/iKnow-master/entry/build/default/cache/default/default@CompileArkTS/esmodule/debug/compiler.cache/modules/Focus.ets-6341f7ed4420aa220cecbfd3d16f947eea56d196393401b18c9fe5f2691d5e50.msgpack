                  .backgroundColor(Colors.CARD)
                  .height(38)
                  .borderRadius(19)
                  .onClick(() => {
                    this.showEndConfirm = true
                  })
              }
              .margin({ top: 16 })
            }
            .width('86%')
            .padding(16)
