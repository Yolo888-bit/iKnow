            Text(this.perceptionMode === 'PERCEPTION_TIMER_ONLY' ? 'æœ¬æ¬¡æœªå¼€å¯æ„ŸçŸ¥' : 'æ‘„åƒå¤´æ„ŸçŸ¥ä¸­')
              .fontSize(12)
              .fontColor(Colors.TEXT_SECONDARY)
