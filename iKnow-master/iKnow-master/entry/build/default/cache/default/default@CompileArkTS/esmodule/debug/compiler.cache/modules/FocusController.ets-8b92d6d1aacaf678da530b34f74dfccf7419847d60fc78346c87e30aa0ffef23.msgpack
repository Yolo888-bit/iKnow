    demoCycleState() {
        if (this.qaMode || this.resting || this.paused) {
            return;
        }
        if (this.state === FocusState.FOCUSED) {
            FocusDetectionService.getInstance().simulate(FocusState.SLIGHTLY_DISTRACTED);
        }
        else if (this.state === FocusState.SLIGHTLY_DISTRACTED) {
