      return
    }
    if (this.resting) {
      this.breakSec++
      this.pushLive()
      return
    }
    this.totalSec++
    if (this.qaMode) {
      this.qaSec++
    } else if (this.state === FocusState.FOCUSED) {
      this.focusSec++
    } else {
      this.distractionSec++
    }
    this.stateSinceSec++
    this.sampleCounter++
    if (this.sampleCounter >= 30) {
      this.sampleCounter = 0
      this.sampleTimeline()
    }
    this.pushLive()
  }

