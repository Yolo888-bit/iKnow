        return 25 + Math.round(Math.random() * 15);
    }
    /** è¯„ä¼°æ˜¯å¦å¹²é¢„ï¼ˆç» InterventionEngineï¼ŒPhase 0 ä»…å†³ç­–+è®°å½•ï¼ŒUI å‘ˆç°ç•™å¾…ç¬¬ 1 æ­¥ï¼‰ */
    evaluateIntervention() {
        const ctx = {
