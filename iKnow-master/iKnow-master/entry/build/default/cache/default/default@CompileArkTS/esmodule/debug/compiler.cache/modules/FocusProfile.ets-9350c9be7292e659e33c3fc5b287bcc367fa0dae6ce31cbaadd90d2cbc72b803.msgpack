        // ä¸“æ³¨æˆé•¿è¶‹åŠ¿
        Column() {
          Text('ä¸“æ³¨æˆé•¿è¶‹åŠ¿')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .width('100%')

          Text(`è¿‘ 30 å¤©å¹³å‡ä¸“æ³¨æ—¶é•¿  ${this.trendStart()} min â†’ ${this.trendEnd()} min`)
            .fontSize(15)
            .fontColor(Colors.TEXT_PRIMARY)
