          this.profileRow('é»„é‡‘ä¸“æ³¨æ—¶æ®µ', this.profile.bestFocusTime)
          this.profileRow('æœ€å®¹æ˜“åˆ†å¿ƒçš„ä»»åŠ¡', this.hardest)
