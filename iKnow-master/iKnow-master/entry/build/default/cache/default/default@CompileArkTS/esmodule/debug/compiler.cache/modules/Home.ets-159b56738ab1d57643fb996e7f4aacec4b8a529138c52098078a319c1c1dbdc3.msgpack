          .backgroundColor(Colors.PRIMARY)
          .borderRadius(Radius.LG)
          .onClick(() => {
            this.startFocus()
          })

        // AI ä¸»åŠ¨å»ºè®®
        if (this.showProactive) {
          Column() {
            Row() {
              Text('ğŸ’¡ å°ä¼´å‘ç°').fontSize(13).fontColor(Colors.PRIMARY_DARK)
              Blank()
              Text('ç¨å')
                .fontSize(13)
                .fontColor(Colors.TEXT_TERTIARY)
                .onClick(() => {
                  this.showProactive = false
                })
            }
            .width('100%')

            Text(AIService.getInstance().proactive(AppStore.getInstance().getProfile().bestFocusTime))
              .fontSize(15)
              .fontColor(Colors.TEXT_PRIMARY)
              .lineHeight(22)
              .margin({ top: 10 })

            Row() {
              Button('å¼€å§‹')
                .fontSize(14)
                .fontColor(Color.White)
                .backgroundColor(Colors.PRIMARY)
                .height(36)
                .borderRadius(18)
                .onClick(() => {
                  this.showProactive = false
                  router.pushUrl({ url: 'pages/TaskPlanning' })
                })
              Button('ç¨å')
                .fontSize(14)
                .fontColor(Colors.TEXT_SECONDARY)
                .backgroundColor(Colors.CARD)
                .height(36)
                .borderRadius(18)
                .margin({ left: 12 })
                .onClick(() => {
                  this.showProactive = false
                })
            }
            .margin({ top: 12 })
          }
          .width('100%')
          .padding(16)
          .backgroundColor(Colors.PRIMARY_SOFT)
          .borderRadius(Radius.MD)
        }

        Blank().height(20)
      }
      .padding(20)
      .width('100%')
    }
    .backgroundColor(Colors.BG)
    .width('100%')
    .height('100%')
  }
}
