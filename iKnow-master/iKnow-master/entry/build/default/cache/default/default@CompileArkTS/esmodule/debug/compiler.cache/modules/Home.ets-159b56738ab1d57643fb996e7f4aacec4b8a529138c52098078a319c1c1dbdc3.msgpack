    this.goalTitle = goal.title
    this.examType = goal.examType
    this.completionRate = this.todayTotal > 0 ? Math.round(this.todayDone / this.todayTotal * 100) : 0
  }

  private startFocus(): void {
    if (this.plan.length === 0) {
      router.pushUrl({ url: 'pages/TaskPlanning' })
      return
    }
    // æ‘„åƒå¤´æ„ŸçŸ¥æˆæƒå‰ç½®ï¼šå·²æˆæƒç›´æ¥ä½¿ç”¨ï¼›æœªæˆæƒå¼¹å‡ºé€‰æ‹©ï¼Œæ‹’ç»åˆ™é™çº§ä»…è®¡æ—¶æ¨¡å¼
    if (PermissionService.getInstance().isCameraOn()) {
      router.pushUrl({ url: 'pages/Focus' })
      return
    }
    AlertDialog.show({
      title: 'å¼€å¯æ‘„åƒå¤´æ„ŸçŸ¥ï¼Ÿ',
      message: 'å¼€å¯åï¼Œæˆ‘ä¼šç”¨å‰ç½®æ‘„åƒå¤´åœ¨æœ¬åœ°æ„ŸçŸ¥ä½ çš„ä¸“æ³¨çŠ¶æ€ï¼Œå…¨ç¨‹ä¸å‡ºç«¯ã€ä¸ä¸Šä¼ ã€‚ä½ ä¹Ÿå¯ä»¥é€‰æ‹©ä»…è®¡æ—¶æ¨¡å¼ã€‚',
      primaryButton: {
        value: 'å¼€å¯æ„ŸçŸ¥',
        action: () => {
          PermissionService.getInstance().grant('camera')
          router.pushUrl({ url: 'pages/Focus' })
        }
      },
      secondaryButton: {
        value: 'ä»…è®¡æ—¶å¼€å§‹',
        action: () => {
          router.pushUrl({ url: 'pages/Focus' })
        }
      }
    })
  }

  @Builder
  statTile(value: string, label: string) {
    Column() {
      Text(value)
        .fontSize(22)
        .fontWeight(FontWeight.Medium)
        .fontColor(Colors.TEXT_PRIMARY)
      Text(label)
        .fontSize(12)
        .fontColor(Colors.TEXT_SECONDARY)
        .margin({ top: 4 })
    }
    .layoutWeight(1)
    .alignItems(HorizontalAlign.Center)
  }

  build() {
    Scroll() {
      Column({ space: Spacing.LG }) {
        // é¡¶éƒ¨é—®å€™
        Row() {
          Column() {
            Text(`${TimeUtils.greeting(Date.now())}ï¼Œ${this.nickname}`)
              .fontSize(26)
              .fontWeight(FontWeight.Bold)
              .fontColor(Colors.TEXT_PRIMARY)
            Text('ä»Šå¤©ä¹Ÿä¸€èµ·æ…¢æ…¢è¿›å…¥çŠ¶æ€å§')
              .fontSize(14)
              .fontColor(Colors.TEXT_SECONDARY)
              .margin({ top: 6 })
          }
          .alignItems(HorizontalAlign.Start)
          .layoutWeight(1)

          Stack() {
            Text('ğŸ§‘â€ğŸ“')
              .fontSize(26)
              .width(48)
              .height(48)
              .textAlign(TextAlign.Center)
              .backgroundColor(Colors.CARD)
              .borderRadius(24)
            Circle()
              .width(10)
              .height(10)
              .fill(Colors.CAMERA_RED)
              .position({ x: 36, y: 2 })
          }
        }
        .width('100%')

        // ä»Šæ—¥ç›®æ ‡ï¼ˆç‚¹å‡»è¿›å…¥ç›®æ ‡ç¼–è¾‘ / è§„åˆ’ï¼‰
        Column() {
          Row() {
            Text('ä»Šæ—¥ç›®æ ‡')
              .fontSize(16)
              .fontWeight(FontWeight.Medium)
              .fontColor(Colors.TEXT_PRIMARY)
            Blank()
            Text('ç¼–è¾‘ â€º')
              .fontSize(13)
              .fontColor(Colors.PRIMARY_DARK)
          }
          .width('100%')

          Row({ space: 16 }) {
            Column() {
              Text(this.examType)
                .fontSize(20)
                .fontWeight(FontWeight.Bold)
                .fontColor(Colors.PRIMARY_DARK)
              Text(this.goalTitle)
                .fontSize(13)
                .fontColor(Colors.TEXT_SECONDARY)
                .margin({ top: 4 })
            }
            .alignItems(HorizontalAlign.Start)
            .layoutWeight(1)

            Column() {
              Text(`${this.examDays}`)
                .fontSize(28)
                .fontWeight(FontWeight.Bold)
                .fontColor(Colors.TEXT_PRIMARY)
              Text('å¤©')
                .fontSize(12)
                .fontColor(Colors.TEXT_SECONDARY)
            }
            .alignItems(HorizontalAlign.Center)
          }
          .width('100%')
          .margin({ top: 12 })
        }
        .width('100%')
        .padding(20)
        .backgroundColor(Colors.CARD)
        .borderRadius(Radius.LG)
        .onClick(() => {
          router.pushUrl({ url: 'pages/TaskPlanning' })
        })

        // ä»Šæ—¥ä»»åŠ¡
        Column() {
          Row() {
            Text('ä»Šæ—¥ä»»åŠ¡')
              .fontSize(16)
              .fontWeight(FontWeight.Medium)
              .fontColor(Colors.TEXT_PRIMARY)
            Blank()
            Text(`${this.plan.length === 0 ? 'å¾…è§„åˆ’' : this.plan.length + ' é¡¹'}`)
              .fontSize(13)
              .fontColor(Colors.TEXT_SECONDARY)
          }
          .width('100%')
          .margin({ bottom: 12 })

          if (this.plan.length === 0) {
            Column() {
              Text('è¿˜æ²¡æœ‰ä»Šæ—¥è®¡åˆ’')
                .fontSize(15)
                .fontColor(Colors.TEXT_PRIMARY)
              Text('ç‚¹è¿™é‡Œï¼Œè®©å°ä¼´å¸®ä½ è§„åˆ’ä»Šå¤©')
                .fontSize(13)
                .fontColor(Colors.TEXT_SECONDARY)
                .margin({ top: 6 })
            }
            .width('100%')
            .padding(20)
            .backgroundColor(Colors.CARD)
            .borderRadius(Radius.MD)
            .onClick(() => {
              router.pushUrl({ url: 'pages/TaskPlanning' })
            })
          } else {
            Column({ space: Spacing.SM }) {
              ForEach(this.plan, (task: Task) => {
                TaskCard({
                  title: task.title,
                  subject: task.subject,
                  minutes: task.estimatedDuration,
                  done: task.done,
                  showCheckbox: true,
                  onToggle: () => {
                    AppStore.getInstance().togglePlanTask(task.id)
                    this.plan = AppStore.getInstance().getCurrentPlan()
                  }
                })
              }, (task: Task) => task.id)
            }
            .width('100%')
          }
        }
        .width('100%')

        // ä»Šæ—¥æ•°æ®
        Column() {
          Text('ä»Šæ—¥æ•°æ®')
            .fontSize(16)
            .fontWeight(FontWeight.Medium)
            .fontColor(Colors.TEXT_PRIMARY)
            .width('100%')
            .margin({ bottom: 14 })

          Row({ space: 8 }) {
            this.statTile(`${this.focusRate}%`, 'å‡€ä¸“æ³¨ç‡')
            this.statTile(TimeUtils.formatHMin(this.todayFocus), 'ä»Šæ—¥ä¸“æ³¨æ—¶é•¿')
            this.statTile(`${this.completionRate}%`, 'ä»»åŠ¡å®Œæˆç‡')
          }
          .width('100%')
        }
        .width('100%')
        .padding(20)
        .backgroundColor(Colors.CARD)
        .borderRadius(Radius.LG)

        // ä¸»æ“ä½œæŒ‰é’®
        Button('å¼€å§‹ä¸“æ³¨')
          .width('100%')
          .height(52)
          .fontSize(17)
          .fontWeight(FontWeight.Medium)
          .fontColor(Color.White)
          .backgroundColor(Colors.PRIMARY)
          .borderRadius(Radius.LG)
          .onClick(() => {
            this.startFocus()
          })

        Blank().height(20)
      }
      .padding(20)
      .width('100%')
    }
    .backgroundColor(Colors.BG)
    .width('100%')
    .height('100%')
  }
}
