/** æ ¹å®¹å™¨ï¼š4 ä¸ªåº•éƒ¨ Tab */
@Entry
@Component
struct Index {
  @State currentTab: number = 0
  private controller: TabsController = new TabsController()

  @Builder
  tabBar(title: string, index: number, icon: string) {
    Column() {
      Text(icon).fontSize(20)
      Text(title)
        .fontSize(11)
        .margin({ top: 2 })
        .fontColor(this.currentTab === index ? Colors.PRIMARY : Colors.TEXT_SECONDARY)
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
  }

  build() {
    Tabs({ barPosition: BarPosition.End, controller: this.controller }) {
      TabContent() {
        Home()
      }.tabBar(this.tabBar('é¦–é¡µ', 0, 'ğŸ '))

      TabContent() {
        Dashboard()
      }.tabBar(this.tabBar('å·¥ä½œå°', 1, 'ğŸ“Š'))

      TabContent() {
        AICompanion()
      }.tabBar(this.tabBar('AI å­¦ä¼´', 2, 'ğŸ’¡'))

      TabContent() {
        Mine()
      }.tabBar(this.tabBar('æˆ‘çš„', 3, 'ğŸ‘¤'))
    }
    .scrollable(false)
    .barHeight(60)
    .backgroundColor(Colors.BG)
    .onChange((index: number) => {
      this.currentTab = index
    })
  }
}
