    }
    defaultReview() {
        return {
            insight: 'æœ¬æ¬¡å­¦ä¹ å·²å®Œæˆï¼Œç»§ç»­åŠ æ²¹ã€‚',
            suggestions: ['æ¯ 45 åˆ†é’Ÿå·¦å³ä¸»åŠ¨ä¼‘æ¯ä¸€æ¬¡ï¼Œèµ·æ¥æ´»åŠ¨ä¸€ä¸‹']
        };
    }
    defaultPlan() {
        return { tasks: [], summary: 'æˆ‘å…ˆå¸®ä½ è®°ç€ï¼Œç¨åä¸€èµ·è§„åˆ’ã€‚' };
    }
    defaultDialog() {
        return { reply: 'æˆ‘å…ˆå¸®ä½ è®°ç€ï¼Œç¨åä¸€èµ·è§„åˆ’ã€‚', done: false };
    }
    defaultMemory() {
