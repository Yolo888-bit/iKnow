            return 'æ´›å¿…è¾¾æ³•åˆ™é€‚ç”¨äº 0/0 æˆ– âˆ/âˆ å‹æœªå®šå¼ï¼šå½“åˆ†å­åˆ†æ¯éƒ½è¶‹äº 0ï¼ˆæˆ–éƒ½è¶‹äºæ— ç©·ï¼‰æ—¶ï¼Œå¯å¯¹åˆ†å­ã€åˆ†æ¯åˆ†åˆ«æ±‚å¯¼å†å–æé™ã€‚ä½¿ç”¨å‰è¦ç¡®è®¤æ»¡è¶³å¯å¯¼ä¸æœªå®šå¼æ¡ä»¶ï¼Œä¸”æ±‚å¯¼åæé™å­˜åœ¨ã€‚';
        }
        if (q.indexOf('å¯¼æ•°') >= 0 || q.indexOf('é“¾å¼') >= 0) {
            return 'é“¾å¼æ³•åˆ™æ˜¯å¤åˆå‡½æ•°æ±‚å¯¼çš„æ ¸å¿ƒï¼šè‹¥ y = f(g(x))ï¼Œåˆ™ y\' = f\'(g(x)) Â· g\'(x)ã€‚ç”±å¤–å‘å†…ä¸€å±‚å±‚æ±‚å¯¼å†ç›¸ä¹˜ã€‚';
        }
        if (q.indexOf('æé™') >= 0) {
            return 'æ±‚æé™å…ˆåˆ¤æ–­ç±»å‹ï¼šèƒ½ç›´æ¥ä»£å…¥å°±å…ˆä»£å…¥ï¼›å‡ºç° 0/0 å‹ï¼Œä¼˜å…ˆè€ƒè™‘ç­‰ä»·æ— ç©·å°æ›¿æ¢ã€å› å¼åˆ†è§£æˆ–æ´›å¿…è¾¾æ³•åˆ™ã€‚';
        }
        if (q.indexOf('çŠ¶æ€ä¸å¥½') >= 0 || q.indexOf('ç´¯') >= 0 || q.indexOf('ç„¦è™‘') >= 0) {
            return 'çŠ¶æ€æœ‰èµ·ä¼å¾ˆæ­£å¸¸ï¼Œä¸ç”¨é€¼è‡ªå·±ã€‚æˆ‘ä»¬å…ˆä»æœ€å°çš„ä¸€æ­¥å¼€å§‹ï¼šæŠŠä»Šå¤©è¦åšçš„ç¬¬ä¸€ä»¶äº‹ç¼©å°åˆ° 15 åˆ†é’Ÿå°±èƒ½å®Œæˆçš„é‡ï¼Œå¥½å—ï¼Ÿ';
        }
        if (q.indexOf('åˆ†å¿ƒ') >= 0 || q.indexOf('èµ°ç¥') >= 0) {
            return 'å®¹æ˜“åˆ†å¿ƒé€šå¸¸ä¸æ˜¯æ„å¿—åŠ›çš„é—®é¢˜ï¼Œè€Œæ˜¯ä»»åŠ¡å’ŒèŠ‚å¥æ²¡åŒ¹é…ã€‚æˆ‘å»ºè®®æŠŠä»»åŠ¡åˆ‡æˆæ›´å°çš„å—ï¼Œæ¯ 25-45 åˆ†é’Ÿå®‰æ’ä¸€æ¬¡çŸ­æš‚ä¼‘æ¯ã€‚';
        }
        return 'è¿™ä¸ªé—®é¢˜æˆ‘è®°ä¸‹äº†ã€‚æŒ‰æˆ‘ç›®å‰çš„æ¨¡æ‹ŸçŸ¥è¯†åº“ï¼Œå…ˆç»™ä½ ä¸€ä¸ªæ–¹å‘ï¼šæŠŠå®ƒæ‹†æˆã€Œå®šä¹‰ â†’ é€‚ç”¨æ¡ä»¶ â†’ å…¸å‹ä¾‹é¢˜ã€ä¸‰æ­¥é€æ­¥å‡»ç ´ã€‚å›åˆ°ä¸“æ³¨åï¼Œæˆ‘ä¼šæŠŠå®ƒå†™è¿›æœ¬æ¬¡å¤ç›˜ã€‚';
    }
    // ===================== 5 æœåŠ¡æ¥å£å®ç°ï¼ˆcanonicalï¼‰=====================
    async plan(req) {
        return this.runWithRetry('task_plan', req.requestId, () => this.producePlan(req.payload), this.defaultPlan());
    }
    async dialog(req) {
        return this.runWithRetry('task_dialog', req.requestId, () => this.produceDialog(req.payload), this.defaultDialog());
    }
    async weeklyInsight(req) {
        return this.runWithRetry('planning', req.requestId, () => this.produceInsight(req.payload), this.defaultPlan());
    }
    async decide(req) {
        return this.runWithRetry('companion', req.requestId, () => this.produceDecision(req.payload), this.defaultCompanion());
    }
    async askText(req) {
        return this.runWithRetry('qa_text', req.requestId, () => this.produceQAText(req.payload), this.defaultQA('qa_text'));
    }
    async askImage(req) {
        return this.runWithRetry('qa_image', req.requestId, () => this.produceQAImage(req.payload), this.defaultQA('qa_image'));
    }
    async generate(req) {
        return this.runWithRetry('review', req.requestId, () => this.produceReview(req.payload), this.defaultReview());
    }
    async update(req) {
        return this.runWithRetry('memory', req.requestId, () => this.produceMemory(req.payload), this.defaultMemory());
    }
    // ===================== å…¼å®¹å«ç‰‡ä¾¿æ·æ–¹æ³•ï¼ˆä¾›ç°æœ‰ AppStore/UI è°ƒç”¨ï¼‰=====================
    toTask(p) {
        const t = new Task();
        t.id = p.id.length > 0 ? p.id : IdUtils.uuid();
        t.title = p.title;
        t.subject = p.subject;
        t.estimatedDuration = p.estimatedDuration;
        t.status = p.status;
        t.done = p.done;
        t.sortOrder = p.sortOrder;
        t.createdAt = Date.now();
        return t;
    }
    /** æ—§ AIService.planTasks ç­‰ä»·å®ç° */
    async planTasks(input) {
        const r = await this.plan({
            requestId: IdUtils.uuid(),
            scene: 'task_plan',
            userId: 'local',
            payload: { goal: input }
        });
        const tasks = (r.data?.tasks ?? []).map((p) => this.toTask(p));
        return tasks;
    }
    async chat(input) {
        return this.knowledgeAnswer(input);
