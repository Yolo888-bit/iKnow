  private static versionFor(scene: AIScene): string {
    switch (scene) {
      case 'qa_text':
      case 'qa_image':
        return QA_SCHEMA_VERSION
      case 'companion':
        return COMPANION_SCHEMA_VERSION
      case 'review':
        return REVIEW_SCHEMA_VERSION
      case 'task_plan':
      case 'task_dialog':
