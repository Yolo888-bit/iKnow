    }
    /** ç»Ÿä¸€æ‰§è¡Œï¼šproduce â†’ SchemaValidator â†’ é‡è¯• 1 â†’ å…œåº• */
    async runWithRetry(scene, requestId, produce, fallbackData) {
        const cfgOpt = MockAIService.TIMEOUTS.get(scene);
        const cfg = cfgOpt !== undefined ? cfgOpt : { timeoutMs: 20000, retries: 1 };
        const tryOnce = async () => {
            try {
                const forced = this.forceTimeoutScenes.has(scene);
                const promise = forced
                    ? (async () => {
                        await this.delay(cfg.timeoutMs + 10);
                        return produce();
                    })()
                    : produce();
                const data = await this.withTimeout(promise, cfg.timeoutMs);
                const v = SchemaValidator.for(scene).validate(data);
                if (v.ok) {
                    return data;
                }
                return null;
            }
            catch (e) {
                return null;
            }
        };
        const first = await tryOnce();
        if (first !== null) {
            return this.ok(scene, requestId, first);
        }
        if (cfg.retries > 0) {
            const second = await tryOnce();
            if (second !== null) {
                return this.ok(scene, requestId, second);
            }
        }
        return this.fallback(scene, requestId, fallbackData);
    }
    // ===================== 5 ä¸ªæœåŠ¡çš„ç”Ÿäº§é€»è¾‘ =====================
    async producePlan(input) {
        await this.delay(550);
        const goal = input.goal;
        const tasks = [];
        const add = (title, subject, min, order) => {
            tasks.push(PlanTask.create(title, subject, min, order));
        };
        if (goal.indexOf('é«˜æ•°') >= 0 || goal.indexOf('æ•°å­¦') >= 0 || goal.indexOf('æé™') >= 0 || goal.indexOf('å¯¼æ•°') >= 0) {
            add('å¤ä¹ æé™ç« èŠ‚', 'é«˜ç­‰æ•°å­¦', 30, 0);
            add('å®Œæˆæé™ç»ƒä¹ é¢˜ 10 é“', 'é«˜ç­‰æ•°å­¦', 30, 1);
            add('å¤ä¹ å¯¼æ•°ç« èŠ‚', 'é«˜ç­‰æ•°å­¦', 30, 2);
            add('å®Œæˆå¯¼æ•°ç»ƒä¹ é¢˜ 10 é“', 'é«˜ç­‰æ•°å­¦', 30, 3);
        }
        else if (goal.indexOf('è‹±è¯­') >= 0 || goal.indexOf('å•è¯') >= 0) {
            add('èƒŒè¯µ 50 ä¸ªæ ¸å¿ƒå•è¯', 'è‹±è¯­', 25, 0);
            add('ç²¾è¯» 1 ç¯‡é˜…è¯»ç†è§£', 'è‹±è¯­', 35, 1);
            add('æ•´ç†ä»Šæ—¥ç”Ÿè¯ä¸é•¿éš¾å¥', 'è‹±è¯­', 20, 2);
        }
        else if (goal.indexOf('æ”¿æ²»') >= 0) {
            add('æ¢³ç†é©¬åŸç¬¬ä¸€ç« æ¡†æ¶', 'æ”¿æ²»', 40, 0);
            add('å®Œæˆ 20 é“é€‰æ‹©é¢˜', 'æ”¿æ²»', 30, 1);
            add('é”™é¢˜å¤ç›˜', 'æ”¿æ²»', 20, 2);
        }
        else {
            add(`å¤ä¹ ã€Œ${goal}ã€æ ¸å¿ƒæ¦‚å¿µ`, 'ç»¼åˆ', 40, 0);
            add(`ã€Œ${goal}ã€ä¸“é¡¹ç»ƒä¹ `, 'ç»¼åˆ', 40, 1);
            add('é”™é¢˜ä¸ç¬”è®°æ•´ç†', 'ç»¼åˆ', 20, 2);
        }
        const summary = `å·²ä¸ºä½ æ‹†å‡º ${tasks.length} ä¸ªä»»åŠ¡ï¼Œé¢„è®¡æ€»æ—¶é•¿çº¦ ${tasks.reduce((a, t) => a + t.estimatedDuration, 0)} åˆ†é’Ÿã€‚`;
        return { tasks, summary };
    }
    async produceDialog(input) {
        await this.delay(420);
        if (input.step === 0) {
            return { reply: 'å¥½çš„ï¼Œå¤§æ¦‚æœ‰å¤šå°‘æ—¶é—´å¯ä»¥å­¦ä¹ å‘¢ï¼Ÿ', done: false };
        }
        if (input.step === 1) {
            return { reply: 'æœ‰æ²¡æœ‰ç‰¹åˆ«æƒ³ä¼˜å…ˆå®Œæˆçš„éƒ¨åˆ†ï¼Ÿ', done: false };
        }
        return {
            reply: 'å¥½çš„ï¼Œæˆ‘å¸®ä½ å®‰æ’ä¸€ä¸‹ã€‚',
            done: true,
            tasks: [
                PlanTask.create('ä¼˜å…ˆä»»åŠ¡å— A', 'ç»¼åˆ', 30, 0),
                PlanTask.create('å·©å›ºç»ƒä¹  B', 'ç»¼åˆ', 30, 1),
                PlanTask.create('æ•´ç†å¤ç›˜ C', 'ç»¼åˆ', 20, 2)
            ]
        };
    }
    async produceInsight(input) {
        await this.delay(500);
        const pref = input.preferredSubject !== undefined ? input.preferredSubject : 'ä¸Šåˆ';
        return {
            tasks: [],
            summary: `ä½ é€šå¸¸åœ¨ ${pref} çŠ¶æ€æœ€å¥½ï¼Œå»ºè®®æŠŠéš¾ç‚¹å®‰æ’åœ¨ç²¾åŠ›é«˜å³°ã€‚`
        };
    }
    async produceDecision(ctx) {
        await this.delay(120);
        return this.buildDecisionSync(ctx);
    }
    /** åŒæ­¥å†³ç­–æ ¸å¿ƒï¼ˆä¾› InterventionEngine åœ¨è®¡æ—¶å¾ªç¯ä¸­åŒæ­¥è°ƒç”¨ï¼‰ */
    buildDecisionSync(ctx) {
        const distracted = ctx.state === 'SLIGHTLY_DISTRACTED' || ctx.state === 'DISTRACTED';
        if (!distracted) {
            return { shouldIntervene: false, level: 'NONE', channel: 'quiet', message: '', action: 'continue' };
        }
        const sinceSec = ctx.sinceMs / 1000;
        let level = 'LIGHT';
        if (ctx.state === 'DISTRACTED' && sinceSec >= 60) {
            level = 'HEAVY';
        }
        // Â§12 ç¡¬è§„åˆ™ï¼šæ— æ‰‹è¡¨æ—¶ RED ç”¨æ‰‹æœºå£°éŸ³ + å±å¹•é€‰æ‹©ï¼Œç»ä¸å‡è£…éœ‡åŠ¨
        const channel = level === 'HEAVY' && ctx.hasWatch ? 'watch-vibrate' : level === 'HEAVY' ? 'phone-sound' : 'screen-select';
        const message = this.wording(ctx.personality, level);
        const action = level === 'HEAVY' ? 'rest' : 'continue';
        return { shouldIntervene: true, level, channel, message, action };
    }
    /** åŒæ­¥å†³ç­–å…¥å£ï¼ˆInterventionEngine è°ƒç”¨ï¼Œä¸è§¦å‘ç½‘ç»œ/å»¶è¿Ÿï¼‰ */
    decideSync(ctx) {
        return this.buildDecisionSync(ctx);
    }
    async produceQAText(payload) {
