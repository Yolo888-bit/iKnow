    }
    if (input.step === 1) {
      return { reply: 'æœ‰æ²¡æœ‰ç‰¹åˆ«æƒ³ä¼˜å…ˆå®Œæˆçš„éƒ¨åˆ†ï¼Ÿ', done: false }
    }
    return {
      reply: 'å¥½çš„ï¼Œæˆ‘å¸®ä½ å®‰æ’ä¸€ä¸‹ã€‚',
      done: true,
      tasks: [
        PlanTask.create('ä¼˜å…ˆä»»åŠ¡å— A', 'ç»¼åˆ', 30, 0),
        PlanTask.create('å·©å›ºç»ƒä¹  B', 'ç»¼åˆ', 30, 1),
