                      this.toggle(task.id)
                    })
                  Column() {
                    Text(task.title)
                      .fontSize(15)
                      .fontColor(task.done ? Colors.TEXT_TERTIARY : Colors.TEXT_PRIMARY)
                    Text(`${task.subject} Â· ${task.estimatedDuration} min`)
                      .fontSize(12)
                      .fontColor(Colors.TEXT_SECONDARY)
                      .margin({ top: 4 })
                  }
                  .alignItems(HorizontalAlign.Start)
                  .margin({ left: 12 })
                  .layoutWeight(1)

                  Text('Ã—')
                    .fontSize(20)
                    .fontColor(Colors.TEXT_TERTIARY)
                    .padding(6)
                    .onClick(() => {
                      this.removeTask(task.id)
                    })
                }
                .width('100%')
                .padding(14)
                .backgroundColor(Colors.CARD)
                .borderRadius(Radius.MD)
              }, (task: Task) => task.id)

              Row() {
                Text('+ æ·»åŠ ä»»åŠ¡')
                  .fontSize(14)
                  .fontColor(Colors.PRIMARY_DARK)
                  .onClick(() => {
                    this.addTask()
                  })
                Blank()
              }
              .width('100%')
              .padding({ top: 8, bottom: 8 })

              Button('ç¡®è®¤è®¡åˆ’å¹¶å¼€å§‹ä¸“æ³¨')
                .width('100%')
                .height(50)
                .fontSize(16)
                .fontWeight(FontWeight.Medium)
                .fontColor(Color.White)
                .backgroundColor(Colors.PRIMARY)
                .borderRadius(Radius.LG)
                .margin({ top: 8 })
                .onClick(() => {
                  this.confirm()
                })
            }
            .width('100%')
            .padding(16)
            .backgroundColor(Colors.BG)
            .borderRadius(Radius.LG)
          }
        }
        .padding(20)
        .width('100%')
      }
      .layoutWeight(1)
      .align(Alignment.Top)

      // è¾“å…¥æ 
      Row() {
        TextInput({ placeholder: 'è¯´è¯´ä½ ä»Šå¤©æƒ³å­¦ä»€ä¹ˆâ€¦' })
          .fontSize(15)
          .height(44)
          .layoutWeight(1)
          .backgroundColor(Colors.CARD)
          .borderRadius(22)
          .onChange((v: string) => {
            this.inputValue = v
          })
          .onSubmit(() => {
            this.send()
          })

        Button('å‘é€')
          .height(44)
          .fontSize(15)
          .fontColor(Color.White)
          .backgroundColor(Colors.PRIMARY)
          .borderRadius(22)
          .margin({ left: 10 })
          .onClick(() => {
            this.send()
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 10, bottom: 16 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor(Colors.BG)
  }
}
